<script>
const deck = document.getElementById('deck');
const slides = [...document.querySelectorAll('.slide')];
const totalSlides = slides.length;

// Build dot nav
const dotNav = document.getElementById('dotNav');
let prevSection = '';
slides.forEach((s, i) => {
  const dot = document.createElement('div');
  dot.className = 'dot';
  const sect = s.dataset.section;
  if (prevSection && sect !== prevSection) dot.classList.add('section-break');
  prevSection = sect;
  dot.onclick = () => { s.scrollIntoView({ behavior: 'smooth' }); };
  dotNav.appendChild(dot);
});

// Slide numbers
slides.forEach((s, i) => {
  const num = s.querySelector('.slide-num');
  if (num) num.textContent = (i + 1) + ' / ' + totalSlides;
});

// Track current slide
let currentSlide = 0;
function updateUI() {
  // Dots
  dotNav.querySelectorAll('.dot').forEach((d, i) => {
    d.classList.toggle('active', i === currentSlide);
  });
  // Progress
  const pct = ((currentSlide + 1) / totalSlides) * 100;
  document.getElementById('progressBar').style.width = pct + '%';
  // Nav links
  const sect = slides[currentSlide].dataset.section;
  document.querySelectorAll('.topbar-link').forEach(l => {
    l.classList.toggle('active', l.dataset.section === sect);
  });
  // Hide hint after first nav
  if (currentSlide > 0) document.getElementById('keyHint').classList.add('hidden');
}

// Intersection observer
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      currentSlide = slides.indexOf(e.target);
      updateUI();
    }
  });
}, { root: deck, threshold: 0.55 });
slides.forEach(s => obs.observe(s));

// Keyboard
document.addEventListener('keydown', e => {
  if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === ' ') {
    e.preventDefault();
    if (currentSlide < totalSlides - 1) slides[currentSlide + 1].scrollIntoView({ behavior: 'smooth' });
  }
  if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
    e.preventDefault();
    if (currentSlide > 0) slides[currentSlide - 1].scrollIntoView({ behavior: 'smooth' });
  }
});

// Section nav
function goToSection(section) {
  const target = slides.find(s => s.dataset.section === section);
  if (target) target.scrollIntoView({ behavior: 'smooth' });
}

// Action toggles
function toggleAct(el) {
  el.classList.toggle('checked');
  const done = document.querySelectorAll('.act-row.checked').length;
  document.getElementById('dDone').textContent = done;
}

// Counters
(function() {
  const now = new Date();
  const pres = new Date('2026-03-23');
  const launch = new Date('2026-05-31');
  const start = new Date('2026-03-13');
  document.getElementById('dPres').textContent = Math.max(0, Math.ceil((pres - now) / 864e5));
  document.getElementById('dLaunch').textContent = Math.max(0, Math.ceil((launch - now) / 864e5));
  document.getElementById('dTotal').textContent = Math.ceil((launch - start) / 864e5);
  if (Math.ceil((pres - now) / 864e5) <= 14) document.getElementById('cc-pres').classList.add('urgent');
})();

updateUI();
</script>

